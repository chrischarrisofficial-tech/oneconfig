{% if switching %}
{{ F }}IGMP from protocol igmp
{{ F }}IGMP then policer NORMAL
{{ F }}IGMP then accept
{% endif %}
{{ F }}ESTABLISHED from protocol tcp
{{ F }}ESTABLISHED from tcp-established
{{ F }}ESTABLISHED then policer IMPORTANT
{{ F }}ESTABLISHED then accept
{{ F }}ICMP from protocol icmp
