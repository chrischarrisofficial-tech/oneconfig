{{ F }}NTP from protocol udp
{{ F }}NTP from port ntp
{{ F }}NTP then policer IMPORTANT
{{ F }}NTP then accept
{% endif %}
{% if s.radius_servers %}
{{ F }}RADIUS from source-prefix-list RADIUS-SERVERS
{{ F }}RADIUS from protocol udp
